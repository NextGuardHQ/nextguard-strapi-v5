{
  "compilerOptions": {
    "outDir"         : "./dist",
    "rootDir"        : "./",
    "target"         : "ES2020",
    "module"         : "CommonJS",
    "moduleResolution": "node",
    "declaration"    : true,
    "strict"         : true,
    "esModuleInterop": true,
    "skipLibCheck"   : true,
    "jsx"            : "react-jsx",
    "baseUrl"        : "."
  },
  "include": ["strapi-server.ts", "strapi-admin.ts", "server/**/*.ts", "admin/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
